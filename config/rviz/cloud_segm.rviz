          Size (Pixels): 3
          Size (m): 0.07999999821186066
          Style: Spheres
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /robot_data/lidar_cloud_semseg
          Use Fixed Frame: true
          Use rainbow: true
          Value: false
        - Alpha: 1
          Autocompute Intensity Bounds: false
          Autocompute Value Bounds:
            Max Value: 6.636961936950684
            Min Value: -2.7851502895355225
            Value: true
          Axis: Z
          Channel Name: traversability
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 0; 255; 0
          Max Intensity: 0.9999949932098389
          Min Color: 239; 41; 41
          Min Intensity: 3.3903470187615837e-37
