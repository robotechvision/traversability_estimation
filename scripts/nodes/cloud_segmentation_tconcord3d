#!/usr/bin/env python

import os
import rclpy
from rclpy.node import Node
from rclpy.time import Time
from sensor_msgs.msg import Image, PointCloud2
from traversability_estimation.msg_numpy import msgify_cloud, numpify
import numpy as np
from numpy.lib.recfunctions import structured_to_unstructured
import torch
from threading import RLock
from tconcord3d.builder import model_builder
from tconcord3d.config.config import load_config_data
from tconcord3d.utils.load_save_util import load_checkpoint
from ament_index_python import get_package_share_directory

# pkg_path = os.path.realpath(os.path.join(os.path.dirname(__file__), '..', '..'))
pkg_path = get_package_share_directory('traversability_estimation')


# transformation between Cartesian coordinates and polar coordinates
def cart2polar(input_xyz):
    rho = np.sqrt(input_xyz[:, 0] ** 2 + input_xyz[:, 1] ** 2)
    phi = np.arctan2(input_xyz[:, 1], input_xyz[:, 0])
    return np.stack((rho, phi, input_xyz[:, 2]), axis=1)


def polar2cat(input_xyz_polar):
    # print(input_xyz_polar.shape)
    x = input_xyz_polar[0] * np.cos(input_xyz_polar[1])
    y = input_xyz_polar[0] * np.sin(input_xyz_polar[1])
    return np.stack((x, y, input_xyz_polar[2]), axis=0)


class CloudSegmentor(Node):
    def __init__(self):
        super().__init__('cloud_segmentor')
        self.lidar_frame = None
        
        self.lock = RLock()
        self.device = self.declare_parameter('device', 'cuda').get_parameter_value().string_value
        cloud_topic = self.declare_parameter('cloud_in', 'cloud_in').get_parameter_value().string_value

        self.model_weights = self.declare_parameter('weights', 'student_kitti_traversablity_f0_0_time_ema.pt').get_parameter_value().string_value
        self.weights_dir = self.declare_parameter('weights_dir', os.path.join(pkg_path, "config/weights/", "t-concord3d")).get_parameter_value().string_value
        self.model_path = os.path.join(self.weights_dir, self.model_weights)
        # assert os.path.exists(self.model_path)
        model_config_path = os.path.join(pkg_path, 'src/tconcord3d/config/semantickitti/'
                                         'semantickitti_S0_0_T11_33_ssl_s20_p80.yaml')
        self.model_config = load_config_data(model_config_path)['model_params']
        self.grid_size = np.asarray(self.model_config['output_shape'])
        self.model = self.load_model()
        self.get_logger().info(f'Loaded cloud segmentation model: {self.model_weights}')

        self.input_pc_fields = ['x', 'y', 'z']
        self.output_pc_fields = ['x', 'y', 'z', 'intensity']

        self.debug = self.declare_parameter('debug', False).get_parameter_value().bool_value

        # point cloud which time stamp is older is not being processed
        self.max_age = self.declare_parameter('max_age', 0.5).get_parameter_value().double_value
        self.fixed_volume_space = self.declare_parameter('fixed_volume_space', True).get_parameter_value().bool_value
        self.max_volume_space = self.declare_parameter('max_volume_space', [50.0, float(np.pi), 2.0]).get_parameter_value().double_array_value
        self.min_volume_space = self.declare_parameter('min_volume_space', [0.0, -float(np.pi), -4.0]).get_parameter_value().double_array_value

        self.segm_cloud_pub = self.create_publisher(PointCloud2, self.declare_parameter('cloud_out', 'points').get_parameter_value().string_value, 1)
        self.depth_pub = self.create_publisher(Image, 'depth', 1)

        self.cloud_sub = self.create_subscription(PointCloud2, cloud_topic, self.segment_cloud_cb, 1)
        self.get_logger().info('Point cloud segmentation node is ready.')

    def load_model(self):
        model = model_builder.build(self.model_config).to(self.device)
        model = load_checkpoint(self.model_path, model)
        model = model.eval()
        return model

    def segment_cloud_cb(self, pc_msg):
        assert isinstance(pc_msg, PointCloud2)
        self.lidar_frame = pc_msg.header.frame_id

        # Discard old messages.
        msg_stamp = self.get_clock().now()
        age = (msg_stamp - Time.from_msg(pc_msg.header.stamp, msg_stamp.clock_type)).nanoseconds/1e9
        if age > self.max_age:
            self.get_logger().warn(f'Cloud segmentation: Discarding points {age:.1f} s > {self.max_age:.1f} s old.')
            return

        t0 = self.get_clock().now().nanoseconds/1e9

        with self.lock:
            cloud = numpify(pc_msg)
            xyz = np.array(structured_to_unstructured(cloud[self.input_pc_fields]))
            self.get_logger().debug(f'Point cloud of shape {cloud.shape} is received')

            xyz = xyz.reshape((-1, 3))
            # xyz[:, 2] += 0.46
            xyz_pol = cart2polar(xyz)

            max_bound_r = np.percentile(xyz_pol[:, 0], 100, axis=0)
            min_bound_r = np.percentile(xyz_pol[:, 0], 0, axis=0)
            max_bound = np.max(xyz_pol[:, 1:], axis=0)
            min_bound = np.min(xyz_pol[:, 1:], axis=0)
            max_bound = np.concatenate(([max_bound_r], max_bound))
            min_bound = np.concatenate(([min_bound_r], min_bound))
            if self.fixed_volume_space:
                max_bound = np.asarray(self.max_volume_space)
                min_bound = np.asarray(self.min_volume_space)

            # get grid index
            crop_range = max_bound - min_bound
            cur_grid_size = self.grid_size
            intervals = crop_range / (cur_grid_size - 1)

            if (intervals == 0).any():
                print("Zero interval!")
            grid_ind = (np.floor((np.clip(xyz_pol, min_bound, max_bound) - min_bound) / intervals)).astype(int)

            # center data on each voxel for PTnet
            voxel_centers = (grid_ind.astype(np.float32) + 0.5) * intervals + min_bound
            cylindr_xyz = xyz_pol - voxel_centers
            cylindr_xyz = np.concatenate((cylindr_xyz, xyz_pol, xyz[:, :2]), axis=1)

            sig = np.zeros((len(cylindr_xyz), 1))
            cylindr_features = np.concatenate((cylindr_xyz, sig), axis=1)

            cylindr_features = torch.as_tensor(cylindr_features, dtype=torch.float32).to(self.device)
            grid_ind_tensor = torch.as_tensor(grid_ind, dtype=torch.float32).to(self.device)
            with torch.no_grad():
                self.get_logger().info(f'Input shapes: {cylindr_features.shape}, {xyz.shape}')

                t0 = self.get_clock().now().nanoseconds/1e9
                predict_labels_raw = self.model([cylindr_features], [grid_ind_tensor], batch_size=1) 
                self.get_logger().info(f'Inference took: {self.get_clock().now().nanoseconds/1e9 - t0} [sec]')
                self.get_logger().debug(f'Output shape: {predict_labels_raw.shape}')

                # predict_labels = torch.argmax(predict_labels_raw, dim=1)

                # print(torch.unique(predict_labels, return_counts=True))
                predict_probability = torch.softmax(predict_labels_raw, dim=1)

                # predict_labels = predict_labels.cpu().numpy().squeeze(0)
                predict_probability = predict_probability.cpu().numpy().squeeze(0)

            # predict_label = predict_labels[grid_ind[:, 0], grid_ind[:, 1], grid_ind[:, 2]]
            predict_prob = predict_probability[:, grid_ind[:, 0], grid_ind[:, 1], grid_ind[:, 2]]

            # predict_labels = np.array(predict_label, dtype=np.float32)
            predict_prob = np.array(predict_prob, dtype=np.float32)

            cost = predict_prob[1].reshape((-1, 1))  # traversability index
            xyz_cost = np.concatenate([xyz, cost], axis=1)
            segm_pc_msg = msgify_cloud(xyz_cost, frame=self.lidar_frame, stamp=self.get_clock().now().to_msg(),
                                       names=self.output_pc_fields)
            self.segm_cloud_pub.publish(segm_pc_msg)


def main(args=None):
    rclpy.init(args=args)
    
    node = CloudSegmentor()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        # Teardown may itself be interrupted by a second SIGINT; keep it quiet either way.
        try:
            node.destroy_node()
            if rclpy.ok():
                rclpy.shutdown()
        except (KeyboardInterrupt, RuntimeError):
            pass


if __name__ == '__main__':
    main()
